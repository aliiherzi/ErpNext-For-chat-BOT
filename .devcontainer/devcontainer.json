{
	"name": "XAL Accountant Bot demo",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
	"forwardPorts": [8080],
	"portsAttributes": {
		"8080": { "label": "ERPNext demo", "onAutoForward": "notify" }
	},
	"postStartCommand": "bash dev/start-demo.sh"
}
